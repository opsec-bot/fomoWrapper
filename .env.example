# Privy access token: localStorage "privy:token" on fomo.family. See README > Getting your tokens.
# Raw JWT, "Bearer <jwt>", or "Authorization: Bearer <jwt>" all work.
FOMO_ACCESS_TOKEN=

# Optional: localStorage "privy:refresh_token". Lets the client renew the access token when it expires.
FOMO_REFRESH_TOKEN=

# Recommended with a refresh token: Privy rotates refresh tokens on every refresh,
# so the new pair is saved here and reused on the next run. The file is gitignored.
# FOMO_TOKEN_FILE=tokens.json

# Optional: override the API host.
# FOMO_BASE_URL=https://prod-api.fomo.family

# Optional: Solana RPC used by `fomo addresses` when a token account has to be looked up.
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
